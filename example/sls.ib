module slkc.sls;

struct Position {
	line: u32,
	column: u32
}

struct Location {
	begin: Position,
	end: Position
}

enum CompletionItemType : u8 {
	Var = 0,
	LocalVar,
	Param,
	Fn,
	Type,
	GenericParam,
	Class,
	Interface,
	Trait,
	Module,
	Enum,
	EnumConst,
	File,
	Keyword
}

class CompletionItem {
	type: CompletionItemType,

	label: string,
	details: string,
	documentations: string,
	insertText: string,

	isDeprecated: bool
}

enum SemanticType : u8 {
	None,		// None
	Type,		// Type
	Class,		// Class
	Enum, 		// Enumeration
	Interface,	// Interface
	Struct,		// Struct
	TypeParam,	// Type parameter
	Param,		// Parameter
	Var,		// Variable
	Property,	// Property
	EnumMember,	// Enumeration member
	Fn,			// Function
	Method,		// Method
	Keyword,	// Keyword
	Modifier,	// Modifier
	Comment,	// Comment
	String,		// String
	Number,		// Number
	Operator	// Operator
}

struct SemanticToken {
	pos: Position,
	length: u32
}
